# Copy this file to .env.local and replace the production placeholders locally.
# Values with VITE_ are bundled into the browser: use ONLY Firebase Web app config.
# Firebase Console > Project settings > General > Your apps > Web SDK config.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# Server only: Firebase Admin service account. Never prefix these with VITE_.
# Get private values from your downloaded service-account JSON, without posting them.
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
# Preserve literal \n escapes in the quoted key, or use multiline secret entry in Vercel.
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key"

# Alternative for LOCAL DEVELOPMENT only: use the downloaded private JSON.
# Keep it ignored; do not upload this file/path to Vercel. Split variables above
# are the production option. A private JSON can also be kept outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=./journas-service-account.json

# Server only: generate a high-entropy random secret locally for Vercel daily cron.
CRON_SECRET=replace-with-a-long-random-secret

# LOCAL EMULATOR MODE ONLY: uncomment these, change both project IDs above to
# demo-journas, use demo Web config, and never deploy emulator values to Vercel.
# VITE_USE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# API_PORT=3001
