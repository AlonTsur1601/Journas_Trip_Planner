# Isolated staging only. Copy to .env.staging.local; never copy production secrets/data.
JOURNAS_ENV=monetization-staging
VITE_JOURNAS_ENV=monetization-staging
FIREBASE_PROJECT_ID=journas-monetization-2026
VITE_FIREBASE_PROJECT_ID=journas-monetization-2026
VITE_FIREBASE_AUTH_DOMAIN=journas-monetization-2026.firebaseapp.com
VITE_FIREBASE_APP_ID=replace-with-staging-web-app-id
# Private server credential used by the same-origin Firebase Auth proxy.
FIREBASE_WEB_API_KEY=replace-locally
FIREBASE_CLIENT_EMAIL=replace-with-staging-service-account-email
FIREBASE_PRIVATE_KEY="replace-locally"
STAGING_PUBLIC_URL=https://journas-monetization-staging.vercel.app
STAGING_ALLOWED_EMAILS=tourist@journas.test,traveler@journas.test,adventurer@journas.test,billing@journas.test
CRON_SECRET=replace-locally
BILLING_ENV=sandbox
ADS_MODE=mock
# Private Paddle server credentials. Leave disconnected until Sandbox setup is complete.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Public Sandbox client token for Paddle.js, beginning test_. Never use a live token.
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_TRAVELER_MONTH=
PADDLE_PRICE_TRAVELER_YEAR=
PADDLE_PRICE_ADVENTURER_MONTH=
PADDLE_PRICE_ADVENTURER_YEAR=
# Optional separate staging email provider. Do not reuse production mail credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Journas Testing"
SMTP_FROM_EMAIL=
