rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationCampaign == 'email-confirmation-2026-10-17' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verifiedEmail == request.auth.token.email; }
    function member(tripId) {
      return verified() && exists(/databases/$(database)/documents/trips/$(tripId))
        && get(/databases/$(database)/documents/trips/$(tripId)).data.deleted == false
        && (!('ownerCleanupAt' in get(/databases/$(database)/documents/trips/$(tripId)).data) || request.time.toMillis() < get(/databases/$(database)/documents/trips/$(tripId)).data.ownerCleanupAt)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/trips/$(tripId))
        && request.time.toMillis() < get(/databases/$(database)/documents/users/$(request.auth.uid)/trips/$(tripId)).data.cleanupAt
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }
    match /trips/{tripId} {
      allow read: if member(tripId);
      allow write: if false;
      match /days/{date} {
        allow read: if member(tripId);
        allow write: if false;
        match /items/{itemId} { allow read: if member(tripId); allow write: if false; }
      }
    }
    // A secret link hash reveals only whether that capability is still active.
    match /shareStatus/{linkHash} { allow get: if true; allow list, write: if false; }
    match /users/{uid} {
      allow read: if verified() && request.auth.uid == uid;
      allow write: if false;
      match /trips/{tripId} { allow read: if verified() && request.auth.uid == uid; allow write: if false; }
      match /layouts/{layoutId} { allow read: if verified() && request.auth.uid == uid && member(resource.data.tripId); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
