{
  "name": "journas-trip-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:dev": "tsx server/dev.ts",
    "dev:api": "tsx --env-file=.env.local server/dev.ts",
    "dev:emulators": "firebase emulators:start --only auth,firestore --project demo-journas"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    },
    "@grpc/grpc-js": "^1.14.5",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@opentelemetry/core": "^2.8.0"
  }
}
